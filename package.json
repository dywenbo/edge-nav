{
  "name": "edge-nav",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Manifest V3 可自由拖拽布局的自定义新标签页扩展",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "preview": "vite preview --port 5274 --strictPort",
