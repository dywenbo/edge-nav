    "check:budget": "node scripts/check-budget.mjs",
    "check:migrate": "node scripts/migrate-check.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.10"
  }
