{
  "manifest_version": 3,
  "name": "edge-nav · 自定义新标签页",
  "short_name": "edge-nav",
  "version": "0.7.0",
  "description": "可自由拖拽布局的新标签页：磁吸对齐与自动去留白、搜索、书签文件夹导航、命令面板、专注计时、待办、工作日历、记事本。",
  "minimum_chrome_version": "110",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage", "unlimitedStorage", "favicon", "bookmarks"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://fastly.jsdelivr.net/*",
    "https://gcore.jsdelivr.net/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
